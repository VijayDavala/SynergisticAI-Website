{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.synergisticaisolns.com"
        }
      ],
      "destination": "https://synergisticaisolns.com/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "https://synergisticaisolns.com/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "https://synergisticaisolns.com/",
      "permanent": true
    },
    {
      "source": "/careers",
      "destination": "https://synergisticaisolns.com/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "https://synergisticaisolns.com/",
      "permanent": true
    },
    {
      "source": "/services/ai-automations",
      "destination": "https://synergisticaisolns.com/",
      "permanent": true
    },
    {
      "source": "/services/digital-marketing",
      "destination": "https://synergisticaisolns.com/",
      "permanent": true
    },
    {
      "source": "/industries",
      "destination": "https://synergisticaisolns.com/",
      "permanent": true
    },
    {
      "source": "/process",
      "destination": "https://synergisticaisolns.com/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/digital-marketing/:page",
      "destination": "/digital-marketing/:page.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://code.tidio.co https://widget.tidio.co https://cdn.jsdelivr.net https://connect.facebook.net https://snap.licdn.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.tidio.co https://images.unsplash.com https://www.facebook.com https://px.ads.linkedin.com https://www.googletagmanager.com; connect-src 'self' https://*.tidio.co wss://*.tidio.co https://pduemybwotfrtznpvyii.supabase.co https://connect.facebook.net https://www.facebook.com https://snap.licdn.com https://www.google-analytics.com https://region1.google-analytics.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://pduemybwotfrtznpvyii.supabase.co; upgrade-insecure-requests"
        }
      ]
    }
  ]
}